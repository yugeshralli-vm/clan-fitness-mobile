{
  "expo": {
    "name": "Clan Fitness",
    "slug": "clan-fitness-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clanfitnessmobile",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.clan.fitness"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0d0d0d",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.clan.fitness",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ],
      "versionCode": 3
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0d0d0d",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "@clerk/expo",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Satoshi",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Satoshi-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/Satoshi-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Satoshi-Bold.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/Satoshi-Bold.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Satoshi-Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Satoshi-Regular.ttf",
              "./assets/fonts/Satoshi-Medium.ttf",
              "./assets/fonts/Satoshi-Bold.ttf",
              "./assets/fonts/Satoshi-Black.ttf"
            ]
          }
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "./plugins/withHealthConnectPrivacyPolicy",
      "./plugins/withReleaseSigning",
      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#3bffad"
              },
              "windowBackground": {
                "light": "#121212"
              },
              "textColor": {
                "light": "#e6e6e6"
              },
              "textColorPrimary": {
                "light": "#e6e6e6"
              },
              "textColorSecondary": {
                "light": "#808080"
              },
              "textColorPrimaryInverse": {
                "light": "#0d0d0d"
              },
              "textColorSecondaryInverse": {
                "light": "#0d0d0d"
              }
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
